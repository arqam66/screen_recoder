{
  "name": "screen-recorder",
  "version": "1.3.0",
  "description": "Screen recorder with face cam overlay, system audio capture, annotation tools, and instant local download",
  "main": "main.js",
  "author": "Arqam",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.screenrecorder",
    "productName": "Screen Recorder",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "assets/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "has-flag": "^5.0.1"
  }
}
